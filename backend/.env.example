# 复制本文件为 .env，然后填入你的 DeepSeek API Key
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填入你的key

# 可选：指定模型。
# 注意用官方当前名称：deepseek-v4-flash 是废弃别名，虽然仍能路由到
# deepseek-flash，但接口返回的模型名会是 deepseek-flash，
# 可观测性日志里也会显示后者 —— 直接写正式名可以少一层困惑。
DEEPSEEK_MODEL=deepseek-flash

# 记忆存储：设置后走真 Redis，不设则退回 fakeredis 内存引擎。
# fakeredis 的数据存在进程内存里，**服务一重启画像和会话历史就没了**，
# 只适合临时演示。想要跨重启保留，用 Docker 起一个：
#
#   docker run -d --name health-planner-redis --restart unless-stopped \
#     -p 6379:6379 -v hp-redis-data:/data \
#     redis:7-alpine redis-server --appendonly yes
#
# 国内直连 Docker Hub 通常会超时，可改用镜像源：
#   docker pull docker.m.daocloud.io/library/redis:7-alpine
#   docker tag  docker.m.daocloud.io/library/redis:7-alpine redis:7-alpine
#
# 说明：--appendonly yes 打开 AOF，配合命名卷 hp-redis-data，
# 容器重启（甚至 Docker Desktop 重启）后数据仍在。
REDIS_URL=redis://localhost:6379/0

# 可观测性（均可选）
# TRACE_ENABLED=1                  设为 0 关闭 JSONL 落盘（内存指标仍会更新）
# TRACE_DIR=./logs                 事件落盘目录
# PRICE_INPUT_PER_M=2.0            成本估算单价（元/百万 token），按官方价目表填
# PRICE_OUTPUT_PER_M=8.0
